{
  "name": "assistente-voz",
  "productName": "Assistente de Voz",
  "version": "2.0.0",
  "private": true,
  "description": "Assistente de voz que abre pastas, programas e controla o PC",
  "main": "electron/main.js",
  "scripts": {
    "ui": "vite",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "test": "node --test",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@google/genai": "^2.28.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "vosk-browser": "0.0.8"
  },
  "build": {
    "appId": "com.assistente.voz",
    "productName": "Assistente de Voz",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "build/icon.png", "build/tray-ativo.png", "package.json"],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Assistente de Voz"
    },
    "portable": { "artifactName": "AssistenteDeVoz-portatil.exe" }
  }
}
